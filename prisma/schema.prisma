generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Items {
  id        String  @id @default(cuid())
  item      String  @unique
  quantity  Int     @default(0)
  unity     String
  category  String
  isChecked Boolean @default(false)

  @@map("table_items")
}
